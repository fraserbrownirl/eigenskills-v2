#!/bin/bash
# EigenCloud billing status checker

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$SCRIPT_DIR/backend/.env"

if [ -f "$ENV_FILE" ]; then
  PRIVATE_KEY=$(grep '^EIGENCOMPUTE_PRIVATE_KEY=' "$ENV_FILE" | cut -d'=' -f2)
fi

if [ -z "$PRIVATE_KEY" ]; then
  echo "Error: EIGENCOMPUTE_PRIVATE_KEY not found in $ENV_FILE"
  exit 1
fi

echo "$PRIVATE_KEY" | ecloud billing status
